# Backend API base (includes the /api/v1 prefix)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Epic 23 (Web Push) — set to 1 to register the service worker in dev too,
# so push notifications can be exercised manually against a local build.
# Leave unset in normal dev (the SW only registers in production by default).
NEXT_PUBLIC_SW_DEV=
