{
  "name": "gxp-guest-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "npm run check:i18n && npm run build:offline && next build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "start": "next start -p 3002",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.414.0",
    "next": "14.2.5",
    "next-intl": "^3.26.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
